# Defaults for `npm test`. Committed on purpose — these point at a local insecure cluster and
# contain no secrets. Node loads this via --env-file before any module runs, which is why the
# config module can read it at import time.
#
# Start a cluster first:
#   cockroach start-single-node --insecure --listen-addr=localhost:26257
#   cockroach sql --insecure -e 'CREATE DATABASE IF NOT EXISTS memora_test'
NODE_ENV=test
DATABASE_URL=postgresql://root@localhost:26257/memora_test?sslmode=disable
EMBEDDING_PROVIDER=local
RATE_LIMIT_PER_MINUTE=0
