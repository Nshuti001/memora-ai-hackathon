# Copy to .env and fill in. See ../SETUP.md for where each value comes from.
# .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# CockroachDB Cloud: cluster page -> Connect -> General connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Local development against a single-node cluster instead:
#   cockroach start-single-node --insecure --listen-addr=localhost:26257
# DATABASE_URL=postgresql://root@localhost:26257/memora_dev?sslmode=disable

# CockroachDB Cloud Managed MCP Server (read-only agent access to the cluster)
COCKROACH_MCP_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Which model turns text into vectors. All three real options are 1024-dim, matching VECTOR(1024).
#   "auto"    Titan -> Cohere -> local, demoting only as each proves unavailable (recommended).
#   "cohere"  Cohere Embed v3 on Bedrock. Real semantics, and on a new AWS account this is often
#             the ONLY embedding model with on-demand quota granted — see SETUP.md step 3.
#   "bedrock" Amazon Titan Text Embeddings V2 only; fails hard when throttled.
#   "local"   Offline lexical stand-in. No credentials, no semantics. Tests and local dev only.
EMBEDDING_PROVIDER=auto

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
# AWS_REGION must be a real region code (us-east-1, us-west-2, …). Do NOT set it to "global".
# "global" is only the prefix on Claude inference profile IDs (see BEDROCK_MODEL_ID).
# Prefer the same region as your CockroachDB Cloud cluster (ours: aws-us-east-1 → us-east-1).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Claude Sonnet 4.6 — Global cross-Region inference profile (what the Bedrock console
# labels "Global", not Southeast). This is the working ID for on-demand Claude on Bedrock.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Titan embeddings stay regional (no global. prefix).
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Used when EMBEDDING_PROVIDER is "cohere", or when "auto" demotes past Titan.
COHERE_EMBED_MODEL_ID=cohere.embed-english-v3

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=8787
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# Optional auth. Comma-separated key:tenant pairs, e.g. "sk-abc:acme,sk-def:globex".
# Unset, every request runs as the "demo" tenant — fine locally, not for a public deployment.
# MEMORA_API_KEYS=
